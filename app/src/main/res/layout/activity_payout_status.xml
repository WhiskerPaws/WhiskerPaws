<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA"
    android:padding="16dp">

    <!-- Premium Balance Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:layout_marginBottom="16dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Redeemable Balance"
            android:textColor="#777777"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/txtPayoutBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🪙 12,450 pawcoins"
            android:textColor="#FFB300"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estimated Value: $12.45 USD"
            android:textColor="#4CAF50"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Cash-Out Progression Tracker -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏱️ Current Payout Progress"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#333333"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:layout_marginBottom="20dp"
        android:elevation="1dp">

        <TextView
            android:id="@+id/txtStatusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: ⏳ Processing Review"
            android:textColor="#FF9800"
            android:textStyle="bold"
            android:textSize="15sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Submitted: Nov 01, 2026 • Method: GCash"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginTop="4dp"/>
            
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginVertical="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Standard manual auditing takes 24–48 hours to secure app revenue margins before release tokens clear."
            android:textColor="#666666"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Cash Out Options Area -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💵 Payout Tiers (PHP / USD)"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#333333"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnRequestPayout"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Request Payout ($10.00 Minimum)"
        android:backgroundTint="#1A73E8"
        android:textColor="#FFFFFF"
        android:textStyle="bold"/>
</LinearLayout>
