<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F8">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MoneyPaws Hub" android:textSize="22sp" android:textStyle="bold" android:textColor="#111111"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Everyday Multi-Utility Linker" android:textSize="12sp" android:textColor="#666666"/>
                </LinearLayout>
                <Button android:id="@+id/btnLedger" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🪙 Wallet" android:backgroundTint="#FFB300" android:textColor="#111111" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:background="#FFFFFF"
                android:padding="4dp"
                android:elevation="1dp">
                <EditText
                    android:id="@+id/editUtilitySearch"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="Search store, merchant or type URL..."
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:background="@android:color/transparent"
                    android:inputType="textUri"/>
                <Button android:id="@+id/btnSearchGo" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="GO" android:backgroundTint="#1A73E8"/>
            </LinearLayout>
            <TextView android:id="@+id/txtSavedTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📌 Saved Profile Portals &amp; Billers" android:textSize="15sp" android:textStyle="bold" android:textColor="#444444" android:layout_marginBottom="8dp" android:visibility="gone"/>
            <HorizontalScrollView android:id="@+id/scrollSavedPortals" android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:layout_marginBottom="20dp" android:visibility="gone"><LinearLayout android:id="@+id/containerSavedPortals" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/></HorizontalScrollView>

            <Button android:id="@+id/btnDailyCheckin" android:layout_width="match_parent" android:layout_height="50dp" android:text="📆 Claim Today's Attendance Bonus" android:layout_marginBottom="16dp" android:backgroundTint="#4CAF50" android:textColor="#FFFFFF"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚀 Careers &amp; AI Intelligence" android:textSize="15sp" android:textStyle="bold" android:textColor="#444444" android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btnJobBoard" android:layout_width="match_parent" android:layout_height="60dp" android:text="💼 Job Board Marketplace" android:gravity="start|center_vertical" android:paddingStart="16dp" android:layout_marginBottom="10dp" android:textColor="#FFFFFF" android:backgroundTint="#1A73E8"/>
            
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:layout_marginBottom="20dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnChatGPT" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ChatGPT" android:layout_marginEnd="6dp" android:backgroundTint="#10A37F"/>
                    <Button android:id="@+id/btnGemini" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gemini" android:layout_marginEnd="6dp" android:backgroundTint="#1A73E8"/>
                    <Button android:id="@+id/btnClaude" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Claude AI" android:layout_marginEnd="6dp" android:backgroundTint="#D97706"/>
                    <Button android:id="@+id/btnGrok" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Grok" android:layout_marginEnd="6dp" android:backgroundTint="#000000"/>
                    <Button android:id="@+id/btnPerplexity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Perplexity" android:backgroundTint="#22D3EE" android:textColor="#111111"/>
                </LinearLayout>
            </HorizontalScrollView>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🧩 Core Ecosystem Utilities" android:textSize="15sp" android:textStyle="bold" android:textColor="#444444" android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btnFXTracker" android:layout_width="match_parent" android:layout_height="58dp" android:text="📈 USD to PHP Live Exchange Tracker" android:gravity="start|center_vertical" android:paddingStart="16dp" android:layout_marginBottom="10dp" android:textColor="#222222" android:backgroundTint="#FFFFFF"/>
            <Button android:id="@+id/btnSocial" android:layout_width="match_parent" android:layout_height="58dp" android:text="💬 Social &amp; Messaging Networks" android:gravity="start|center_vertical" android:paddingStart="16dp" android:layout_marginBottom="10dp" android:textColor="#222222" android:backgroundTint="#FFFFFF"/>
            <Button android:id="@+id/btnGovernment" android:layout_width="match_parent" android:layout_height="58dp" android:text="🏛️ News, Business &amp; Public Portals" android:gravity="start|center_vertical" android:paddingStart="16dp" android:layout_marginBottom="10dp" android:textColor="#222222" android:backgroundTint="#FFFFFF"/>
            <Button android:id="@+id/btnShopping" android:layout_width="match_parent" android:layout_height="58dp" android:text="🛍️ Online Shopping Marketplace" android:gravity="start|center_vertical" android:paddingStart="16dp" android:layout_marginBottom="10dp" android:textColor="#222222" android:backgroundTint="#FFFFFF"/>
            <Button android:id="@+id/btnEntertainment" android:layout_width="match_parent" android:layout_height="58dp" android:text="🎬 Entertainment &amp; Short Dramas" android:gravity="start|center_vertical" android:paddingStart="16dp" android:layout_marginBottom="10dp" android:textColor="#222222" android:backgroundTint="#FFFFFF"/>
            <Button android:id="@+id/btnHealth" android:layout_width="match_parent" android:layout_height="58dp" android:text="🩺 Health &amp; Wellness Resources" android:gravity="start|center_vertical" android:paddingStart="16dp" android:layout_marginBottom="10dp" android:textColor="#222222" android:backgroundTint="#FFFFFF"/>
            <Button android:id="@+id/btnFinance" android:layout_width="match_parent" android:layout_height="58dp" android:text="💰 Wealth, Crypto &amp; Financials" android:gravity="start|center_vertical" android:paddingStart="16dp" android:layout_marginBottom="10dp" android:textColor="#222222" android:backgroundTint="#FFFFFF"/>
            <Button android:id="@+id/btnUtilities" android:layout_width="match_parent" android:layout_height="58dp" android:text="⚡ Household Utilities &amp; Bills" android:gravity="start|center_vertical" android:paddingStart="16dp" android:layout_marginBottom="10dp" android:textColor="#222222" android:backgroundTint="#FFFFFF"/>
            <Button android:id="@+id/btnTransportation" android:layout_width="match_parent" android:layout_height="58dp" android:text="🚗 Transportation &amp; Logistics" android:gravity="start|center_vertical" android:paddingStart="16dp" android:layout_marginBottom="10dp" android:textColor="#222222" android:backgroundTint="#FFFFFF"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout 
        android:id="@+id/admobBannerContainer" 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content" 
        android:background="#EEEEEE" 
        android:gravity="center" 
        android:orientation="vertical" />
</LinearLayout>
