<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://android.com"
    xmlns:app="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Header Greeting -->
    <LinearLayout
        android:id="@+id/headerBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#FFFFFF"
        android:elevation="2dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_headline"
            android:textColor="#1E293B"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/appreciation_subline"
            android:textColor="#64748B"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Scrollable Portal Dashboard -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerBox"
        android:layout_above="@+id/admobBannerContainer"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Category 1: AI Hub -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🤖 ARTIFICIAL INTELLIGENCE HUB"
                        android:textColor="#2563EB"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                    <Button
                        android:id="@+id/btnChatGPT"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="🚀 Launch ChatGPT"
                        android:backgroundTint="#2563EB" />
                    <Button
                        android:id="@+id/btnGemini"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="✨ Launch Google Gemini"
                        android:backgroundTint="#2563EB" />
                    <Button
                        android:id="@+id/btnClaude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="🧠 Launch Claude AI"
                        android:backgroundTint="#2563EB" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Category 2: Food Portals -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍔 FOOD DELIVERY PLACES"
                        android:textColor="#EA580C"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                    <Button
                        android:id="@+id/btnJollibee"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="🐝 Jollibee Food Delivery"
                        android:backgroundTint="#EA580C" />
                    <Button
                        android:id="@+id/btnMcDo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="🍔 McDonald's McDelivery"
                        android:backgroundTint="#EA580C" />
                    <Button
                        android:id="@+id/btnFoodpanda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="🐼 Foodpanda Portal"
                        android:backgroundTint="#EA580C" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Category 3: Online Shopping -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛍️ ONLINE SHOPPING NETWORK"
                        android:textColor="#DB2777"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                    <Button
                        android:id="@+id/btnLazada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="🧡 Lazada Philippines"
                        android:backgroundTint="#DB2777" />
                    <Button
                        android:id="@+id/btnShopee"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="❤️ Shopee PH Shopping"
                        android:backgroundTint="#DB2777" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- AdMob Footer Anchor Space -->
    <FrameLayout
        android:id="@+id/admobBannerContainer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:background="#F1F5F9" />

</RelativeLayout>
